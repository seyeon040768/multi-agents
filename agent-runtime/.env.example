AGENT_RUNTIME_TOKEN=replace-with-a-long-random-token
# Configure whichever providers you use; no provider is the default.
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
# Existing Mattermost Docker network; compose joins it without changing Mattermost.
MATTERMOST_DOCKER_NETWORK=docker_default

# Docker volume path; local runs can use ./data/checkpoints.sqlite.
CHECKPOINT_DB=/app/data/checkpoints.sqlite

# Optional: web-search tool uses Brave Search, independent of model provider.
BRAVE_SEARCH_API_KEY=
