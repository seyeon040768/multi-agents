{
  "id": "com.seyeon.agentbridge",
  "name": "Multi Agent Bridge",
  "description": "Multi-agent runtime integration for Mattermost.",
  "min_server_version": "6.2.1",
  "server": {
    "executables": {
      "linux-amd64": "server/dist/plugin-linux-amd64",
      "linux-arm64": "server/dist/plugin-linux-arm64",
      "darwin-amd64": "server/dist/plugin-darwin-amd64",
      "darwin-arm64": "server/dist/plugin-darwin-arm64",
      "windows-amd64": "server/dist/plugin-windows-amd64.exe"
    }
  },
  "settings_schema": {
    "header": "",
    "footer": "",
    "settings": [
      {
        "key": "LangGraphURL",
        "display_name": "LangGraph Runtime URL",
        "type": "text",
        "default": "",
        "help_text": "Runtime service base URL reachable from the Mattermost server, e.g. http://agent-runtime:8000."
      },
      {
        "key": "LangGraphToken",
        "display_name": "LangGraph Runtime Token",
        "type": "text",
        "secret": true,
        "default": "",
        "help_text": "Must match AGENT_RUNTIME_TOKEN on the runtime. Provider API keys belong in runtime environment variables."
      }
    ]
  },
  "webapp": {
    "bundle_path": "webapp/dist/main.js"
  }
}
